# Copy to .env for local overrides. Never commit real values.
# Every variable below is optional; production defaults are safe.

ENVIRONMENT=development

# Comma-separated list of exact origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Regex matching preview/production frontend hostnames (defaults to *.vercel.app).
ALLOWED_ORIGIN_REGEX=https://[a-z0-9-]+\.vercel\.app

# Host header allow-list. Add your custom domain if you use one.
ALLOWED_HOSTS=localhost,127.0.0.1,testserver,*.vercel.app

RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# Interactive docs are disabled automatically when ENVIRONMENT=production.
DOCS_ENABLED=true
